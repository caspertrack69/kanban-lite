# Web login password.
APP_PASSWORD=replace-with-a-strong-password

# iron-session encryption key. Must be at least 32 characters.
SESSION_PASSWORD=replace-with-at-least-32-characters-long-secret

# Local development: file:./local.db
# Production (Turso): libsql://<database>-<organization>.turso.io
DATABASE_URL=file:./local.db

# Turso auth token. Leave empty for local files.
DATABASE_AUTH_TOKEN=

# Initial Doing limit when no setting row exists yet.
DOING_LIMIT=3

# Telegram bot (optional outside Telegram features).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Public web app URL, used by the webhook setup script.
APP_URL=http://localhost:3000
