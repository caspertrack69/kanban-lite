      "checkConstraints": {
        "task_status_valid": {
          "name": "task_status_valid",
          "value": "\"task\".\"status\" IS NULL OR \"task\".\"status\" IN ('inbox','backlog','todo','doing','done')"
        },
        "task_status_parent_consistency": {
          "name": "task_status_parent_consistency",
          "value": "(\"task\".\"parent_id\" IS NULL AND \"task\".\"status\" IS NOT NULL) OR (\"task\".\"parent_id\" IS NOT NULL AND \"task\".\"status\" IS NULL)"
        },
        "task_project_consistency": {
          "name": "task_project_consistency",
          "value": "\"task\".\"status\" IS NULL OR (\"task\".\"status\" = 'inbox' AND \"task\".\"project_id\" IS NULL) OR (\"task\".\"status\" <> 'inbox' AND \"task\".\"project_id\" IS NOT NULL)"
        }
